  "landing": {
    "eyebrow": "Voice + scheduling + operations",
    "title": "The front desk that answers, understands and books by voice.",
    "subtitle": "TriaVoz answers your clinic's calls, checks real availability, books, reschedules and cancels appointments, logs everything and hands over to a human when needed.",
    "ctaDemo": "Talk to the demo",
    "ctaLogin": "Open the dashboard",
    "note": "Public demo with fictional data. No medical advice.",
    "metricsCalls": "calls handled",
    "metricsCost": "cost per call",
    "metricsHandoff": "human handoff",
    "howTitle": "One call, three steps",
    "howSubtitle": "The agent never invents a time: it checks the database before offering any option.",
    "how1Title": "Listens and understands",
    "how1Body": "Portuguese STT, barge-in and short replies. The caller talks the way they would to a receptionist.",
    "how2Title": "Checks and confirms",
    "how2Body": "Tools read the real schedule. Only after a clear “yes” is the appointment written — with a database constraint against double booking.",
    "how3Title": "Logs and hands over",
    "how3Body": "Transcript, duration, cost and latency per stage land in the dashboard. Urgencies go straight to SAMU 192 and a human.",
    "featureTitle": "Built for real operations",
    "feature1Title": "Multi-clinic with RLS",
    "feature1Body": "Forced PostgreSQL isolation and a merge-blocking test suite.",
    "feature2Title": "Prank and budget protection",
    "feature2Body": "Per-number, per-IP and per-clinic limits; cost circuit breaker and kill switch. Emergencies are never blocked.",
    "feature3Title": "Human in the loop",
    "feature3Body": "Callbacks, appointments and prank flags in one queue with an audit trail.",
    "faqTitle": "Frequently asked questions",
    "faq1Q": "Does the agent really book appointments?",
    "faq1A": "Yes. It checks real availability and only confirms after the database accepts the slot. An exclusion constraint prevents double booking.",
    "faq2Q": "What happens in an emergency?",
    "faq2A": "The agent stops the flow, tells the caller to call SAMU 192 and records a human handoff. No anti-abuse limit blocks that path.",
    "faq3Q": "Is the data real?",
    "faq3A": "No. The repository only uses fictional clinics, names and phone numbers. In production, health data requires a lawful basis, consent and defined retention.",
    "faq4Q": "How does cost work?",
    "faq4A": "Each call records STT, LLM and TTS with configurable prices. The dashboard shows cost per call and per day, with a daily budget and circuit breaker.",
    "footer": "Portfolio project. No real data.",
    "privacy": "Privacy",
    "source": "Source on GitHub",
    "trusted": "Verifiable architecture",
    "trustedBody": "Forced RLS, service-to-service HMAC, JWT in an httpOnly cookie.",
    "liveLabel": "Live demo",
    "demoLine1": "I'd like to book an appointment tomorrow morning.",
    "demoLine2": "I have 9:30 or 10:15 with Dr. Ana. Which works?"
