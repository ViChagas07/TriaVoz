# Same-origin proxy target for /api/v1 (server-side only; never exposed to the browser)
API_ORIGIN=http://localhost:8000

# Optional Sentry. Leave empty to disable; request bodies and PII are never sent.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Production only: match the API cookie prefix (`__Host-`). Keep empty in local HTTP dev.
COOKIE_PREFIX=
# Optional self-hosted LiveKit; default CSP allows https://*.livekit.cloud.
# NEXT_PUBLIC_LIVEKIT_CONNECT_SRC=wss://livekit.example.com https://livekit.example.com
