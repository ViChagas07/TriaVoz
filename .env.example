# ───────── TriaVoz — copy to .env (never commit .env) ─────────

# Host ports (change only if something else already uses the default)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000
LIVEKIT_WS_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Database roles (created by infra/postgres/init/01-roles.sh on first start)
POSTGRES_SUPERUSER_PASSWORD=change-me
TRIAVOZ_OWNER_PASSWORD=change-me       # migrations only
TRIAVOZ_APP_PASSWORD=change-me         # API runtime (NOBYPASSRLS)
TRIAVOZ_OPS_PASSWORD=change-me         # internal jobs only
# Owner DSN for migrations and scripts/seed_demo.py ONLY (never API/worker runtime).
TRIAVOZ_DATABASE_URL_OWNER=postgresql+psycopg://triavoz_owner:change-me@localhost:5432/triavoz

# API secrets (use >= 32 random bytes: `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
TRIAVOZ_JWT_SECRET=
TRIAVOZ_INTERNAL_HMAC_SECRET=          # shared by the API and the voice worker

# Voice pipeline providers (read by the LiveKit plugins)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
ANTHROPIC_API_KEY=

# API voice session (server-side room creation; the browser receives a short token)
TRIAVOZ_LIVEKIT_PUBLIC_URL=ws://localhost:7880
TRIAVOZ_DEMO_CLINIC_SLUG=clinica-horizonte
TRIAVOZ_COOKIE_SECURE=false            # must be true with HTTPS in production

# Worker settings
TRIAVOZ_LLM_MODEL=                     # pick a FAST model; latency matters more than raw capability here
TRIAVOZ_STT_MODEL=nova-3
TRIAVOZ_STT_LANGUAGE=pt-BR
TRIAVOZ_TTS_VOICE_ID=                  # an ElevenLabs voice with good pt-BR quality
TRIAVOZ_TTS_MODEL=
TRIAVOZ_MAX_CALL_SECONDS=300

# Cost estimate per call (cents). Leave 0 to record usage only; fill from your providers' current price pages.
TRIAVOZ_PRICE_STT_PER_MIN_CENTS=0
TRIAVOZ_PRICE_LLM_IN_PER_M_CENTS=0
TRIAVOZ_PRICE_LLM_OUT_PER_M_CENTS=0
TRIAVOZ_PRICE_TTS_PER_K_CHARS_CENTS=0

# Frontend → API proxy target (server-side)
API_ORIGIN=http://localhost:8000
