# ───────── TriaVoz — copy to .env (never commit .env) ─────────

# Host ports (change only if something else already uses the default)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000
LIVEKIT_WS_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Database roles (created by infra/postgres/init/01-roles.sh on first start)
POSTGRES_SUPERUSER_PASSWORD=change-me
TRIAVOZ_OWNER_PASSWORD=change-me       # migrations only
TRIAVOZ_APP_PASSWORD=change-me         # API runtime (NOBYPASSRLS)
TRIAVOZ_OPS_PASSWORD=change-me         # internal jobs only
# Owner DSN for migrations and scripts/seed_demo.py ONLY (never API/worker runtime).
TRIAVOZ_DATABASE_URL_OWNER=postgresql+psycopg://triavoz_owner:change-me@localhost:5432/triavoz

# API secrets (use >= 32 random bytes: `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
TRIAVOZ_JWT_SECRET=
TRIAVOZ_INTERNAL_HMAC_SECRET=          # shared by the API and the voice worker

# Voice pipeline providers (read by the LiveKit plugins)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
ANTHROPIC_API_KEY=

# API voice session (server-side room creation; the browser receives a short token)
TRIAVOZ_LIVEKIT_PUBLIC_URL=ws://localhost:7880
TRIAVOZ_DEMO_CLINIC_SLUG=clinica-horizonte
TRIAVOZ_COOKIE_SECURE=false            # must be true with HTTPS in production

# Anti-abuse / demo hardening (per caller, per IP and clinic-wide token buckets)
TRIAVOZ_VOICE_CALLER_CAPACITY=3
TRIAVOZ_VOICE_CALLER_REFILL_PER_SECOND=0.0008333333
TRIAVOZ_VOICE_RATE_CAPACITY=10
TRIAVOZ_VOICE_RATE_REFILL_PER_SECOND=0.0027777778
TRIAVOZ_VOICE_GLOBAL_CAPACITY=60
TRIAVOZ_VOICE_GLOBAL_REFILL_PER_SECOND=0.0166666667
TRIAVOZ_DEMO_HARD_MAX_CALL_SECONDS=300
TRIAVOZ_DEMO_DAILY_MINUTE_BUDGET=120
TRIAVOZ_DEMO_DAILY_COST_BUDGET_CENTS=500
TRIAVOZ_DEMO_MAX_TURNS=20
TRIAVOZ_DEMO_SILENCE_TIMEOUT_SECONDS=15
TRIAVOZ_ABUSE_REVIEW_THRESHOLD=50
TRIAVOZ_COST_BREAKER_COOLDOWN_SECONDS=300
# Optional Cloudflare Turnstile challenge for the public demo (leave empty to disable)
TRIAVOZ_TURNSTILE_SECRET=

# Spike alerts (log by default; set SMTP + ALERTS_EMAIL for e-mail)
TRIAVOZ_ALERT_CALLS_PER_HOUR=100
TRIAVOZ_ALERT_COST_CENTS_PER_HOUR=2000
TRIAVOZ_ALERT_PRANK_FLAGS_PER_HOUR=5
TRIAVOZ_ALERTS_EMAIL=
TRIAVOZ_SMTP_HOST=
TRIAVOZ_SMTP_PORT=587
TRIAVOZ_SMTP_USERNAME=
TRIAVOZ_SMTP_PASSWORD=
TRIAVOZ_SMTP_FROM=
TRIAVOZ_SMTP_STARTTLS=true

# Worker settings
# LiveKit Cloud Inference keeps the LLM behind the same LIVEKIT_API_KEY/SECRET.
TRIAVOZ_LLM_MODEL=openai/gpt-4.1-mini
TRIAVOZ_STT_MODEL=nova-3
TRIAVOZ_STT_LANGUAGE=pt-BR
TRIAVOZ_TTS_PROVIDER=cartesia         # elevenlabs is supported when its key is valid
TRIAVOZ_TTS_MODEL=cartesia/sonic-3
TRIAVOZ_TTS_VOICE_ID=                 # provider voice id (Cartesia voice when provider=cartesia)
TRIAVOZ_TTS_LANGUAGE=pt-BR
TRIAVOZ_MAX_CALL_SECONDS=300
TRIAVOZ_MAX_TURNS=20
TRIAVOZ_SILENCE_TIMEOUT_SECONDS=15
TRIAVOZ_EMERGENCY_GRACE_SECONDS=20
TRIAVOZ_HANDOFF_SIP_URI=              # optional: SIP URI for a real phone transfer

# Cost estimate per call (cents), set from current provider price pages (2026-10-19):
# - Deepgram Nova-3 streaming: $0.0048/min
# - LiveKit Inference GPT-4.1 mini: $0.0015/min; token estimate uses OpenAI list $0.40/M in, $1.60/M out
# - Cartesia Sonic via LiveKit Inference: ~$0.03/min (1k chars is a deliberate approximation to 1 min)
TRIAVOZ_PRICE_STT_PER_MIN_CENTS=0.48
TRIAVOZ_PRICE_LLM_IN_PER_M_CENTS=40
TRIAVOZ_PRICE_LLM_OUT_PER_M_CENTS=160
TRIAVOZ_PRICE_TTS_PER_K_CHARS_CENTS=3.0

# Frontend -> API proxy target (server-side)
API_ORIGIN=http://localhost:8000
# Canonical public origin used by metadata/OG/sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3300
